# Environment for local testing
DEBUG=true
PORT=8080
ENVIRONMENT=local

# Gemini API key for location extraction 
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACE_API_KEY=your_google_places_api_key_here

# Path to the Google Cloud service account key file
# When running locally, set the full path to your key file
# When running in production with Google Cloud, this is handled by IAM roles
GOOGLE_APPLICATION_CREDENTIALS=pinit_service_account_.json

# Optional: TikTok API tokens
MS_TOKENS=your_tiktok_api_tokens

# For Firebase emulator
# Set to 'true' to use Firebase emulator instead of production Firebase
USE_FIREBASE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=pinit-10b36