# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Push notifications
SEND_PUSH_NOTIF_SECRET=your_push_notification_secret_here
PUSH_NOTIFICATION_URL=https://europe-west1-pinit-494520.cloudfunctions.net/send-push-notifications

# Downstream services
LOCATIONS_ADD_URL=https://pinit-recommendations-api-jkqbw4i75a-nw.a.run.app/locations/add

# Cloud Tasks (async processing). Leave TASKS_QUEUE unset locally to fall back
# to inline thread processing. All five are required to enqueue real tasks.
GCP_PROJECT=pinit-494520
TASKS_LOCATION=europe-west1
TASKS_QUEUE=social-share-processing
TASKS_SERVICE_ACCOUNT=your_tasks_invoker_service_account_email_here
# Set to the deployed service URL + /tasks/process-share after first deploy.
WORKER_URL=https://social-free-processor-jkqbw4i75a-ew.a.run.app/tasks/process-share

# Local dev
PORT=8080
