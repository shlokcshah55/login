# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Places API Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Apify
APPIFY_KEY=your_appify_key_here

# Push Notification Secret (for sending error notifications)
SEND_PUSH_NOTIF_SECRET=your_push_notification_secret_here
PUSH_NOTIFICATION_URL=https://europe-west1-project-add4b0f5-0080-47ef-80f.cloudfunctions.net/send-push-notifications

# Port for local development (Cloud Run overrides this)
PORT=8080
